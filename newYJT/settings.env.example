# Fill these locally if you want the runtime to become live-ready.
# Keep this file private and do not commit a real settings.env.

# Binance futures credentials
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Single master switch.
# true  -> freqtrade runtime uses the real Binance USD-M account with your keys
# false -> everything stays in paper / dry-run mode
ENABLE_LIVE_TRADING=false

# Paper wallet used only when dry-run is enabled.
DRY_RUN_WALLET=1000

# New entries use this percentage of currently available balance.
DYNAMIC_STAKE_RATIO_PCT=10

# Optional live bridge / preview defaults.
DEFAULT_LEVERAGE=1
DEFAULT_STOP_LOSS_PCT=5
DEFAULT_TAKE_PROFIT_PCT=4

# Optional polling interval for the Binance shadow / actual-account panel.
TRADE_SHADOW_POLL_SECONDS=30

# Optional Binance testnet switch for binanceTrade.py only.
BINANCE_USE_TESTNET=false

# Optional Anthropic key for the upstream LLM runtime.
ANTHROPIC_API_KEY=

# Optional: keep the vendor LLM runtime in simulation by default to avoid duplicate live orders.
ENABLE_LLM_LIVE_TRADING=false

# Optional LLM runtime order size used by the upstream LLM bot.
LLM_TRADE_AMOUNT_USDT=100
